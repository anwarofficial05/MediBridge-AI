{
  "name": "medibridge-ai-backend",
  "version": "1.0.0",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "start:prod": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prisma:generate": "prisma generate --schema ../prisma/schema.prisma",
    "prisma:migrate": "prisma migrate dev --schema ../prisma/schema.prisma --name init",
    "prisma:seed": "tsx src/seed.ts",
    "prisma:studio": "prisma studio --schema ../prisma/schema.prisma",
    "prisma:generate:prod": "prisma generate --schema ../prisma/schema.supabase.prisma",
    "db:push:prod": "prisma db push --schema ../prisma/schema.supabase.prisma",
    "seed:prod": "tsx src/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.16.2",
    "@types/pg": "^8.23.1",
    "bcrypt": "^6.0.0",
    "cors": "^2.8.5",
    "dotenv": "^17.2.2",
    "express": "^5.1.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.0.2",
    "pg": "^8.23.1",
    "zod": "^4.1.8"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.0.0",
    "@types/node": "^24.5.2",
    "prisma": "^6.16.2",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  },
  "engines": {
    "node": ">=20.19"
  }
}
